{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chrome-rift-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "GAME_BUCKET",
      "bucket_name": "chrome-rift-web"
    }
  ]
}